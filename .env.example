# Copy this file to .env and fill in whichever keys you have.
# Anything left blank runs in demo mode (clearly labeled) so the app is
# fully testable with zero setup.

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-something-random

# --- AI assistants being monitored ---
# Claude -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT -- https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Perplexity -- https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Gemini -- https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# DeepSeek -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional model overrides (defaults are current as of Sept 2026; providers
# retire models regularly -- if a provider starts erroring, update these):
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-5.4-mini
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-3.5-flash
# DEEPSEEK_MODEL=deepseek-flash

# --- Business-name autocomplete (strongly recommended in production) ---
# Blank -> free OpenStreetMap search (misses many small local businesses).
# Set -> searches Google's own business listings (the same ones behind
# Google Maps / Google Business Profile) for Business name + Competitors.
# Setup: Google Cloud console -> enable "Places API (New)" (NOT the legacy
# "Places API") -> Credentials -> create API key -> restrict it to
# "Places API (New)". Requires a billing account on the project.
GOOGLE_PLACES_API_KEY=

# --- Stripe billing ---
# https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=
# Two recurring prices: Starter ($29/mo) and Pro ($49/mo) -- see plans.py
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# --- Email alerts (any SMTP provider -- e.g. Gmail app password, Postmark, SES) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
